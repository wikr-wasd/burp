{
  "name": "burp",
  "version": "0.1.0",
  "private": true,
  "description": "Burp — matmarknadsplats och restaurangbeställning (webb, QR vid bordet, dashboard)",
  "author": "wikr-wasd",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev --workspace @burp/web",
    "build": "npm run build --workspace @burp/core && npm run build --workspace @burp/web",
    "start": "npm run start --workspace @burp/web",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:verify": "bash scripts/verify-schema.sh",
    "db:env": "node scripts/write-local-env.mjs",
    "db:types": "node scripts/generate-types.mjs",
    "db:types:remote": "node scripts/generate-types.mjs --remote",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:demo": "node scripts/seed-demo-orders.mjs"
  },
  "devDependencies": {
    "libpg-query": "^17.7.4",
    "supabase": "^2.114.0",
    "typescript": "^5.9.0",
    "vercel": "^58.11.0"
  }
}
