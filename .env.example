# ── Supabase ────────────────────────────────────────────────────────────────
# Publika värden — får exponeras i klienten.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — ENDAST server. Kringgår RLS. Får aldrig nå klienten,
# aldrig committas, aldrig loggas.
SUPABASE_SERVICE_ROLE_KEY=

# Används av `npm run db:types`
SUPABASE_PROJECT_ID=

# ── QR ──────────────────────────────────────────────────────────────────────
# HMAC-nyckel som signerar bordstokens (se packages/core/src/qr.ts).
# Generera: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Byte av nyckeln ogiltigförklarar ALLA utskrivna QR-koder.
QR_TOKEN_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ── Betalning (öppen fråga 5 — se docs/OPEN-QUESTIONS.md) ───────────────────
# Ingen leverantör är beslutad. Nycklarna nedan är platshållare för Stripe Connect
# som är det troligaste förstavalet; byt om beslutet blir Adyen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Burps avgift ────────────────────────────────────────────────────────────
# Standardavgift i baspunkter (340 = 3,40 %). Kan överstyras per restaurang
# via restaurants.fee_override_bps. Se docs/OPEN-QUESTIONS.md fråga 1.
BURP_DEFAULT_FEE_BPS=340
