# ── Supabase ────────────────────────────────────────────────────────────────
# Publika värden — får exponeras i klienten.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — ENDAST server. Kringgår RLS. Får aldrig nå klienten,
# aldrig committas, aldrig loggas.
SUPABASE_SERVICE_ROLE_KEY=

# Används av `npm run db:types`
SUPABASE_PROJECT_ID=

# ── QR ──────────────────────────────────────────────────────────────────────
# HMAC-nyckel som signerar bordstokens (se packages/core/src/qr.ts).
# Generera: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Byte av nyckeln ogiltigförklarar ALLA utskrivna QR-koder.
QR_TOKEN_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ── Betalning ───────────────────────────────────────────────────────────────
# Restaurangen äger sitt eget inlösenavtal; Burp håller aldrig gästens pengar.
# Se docs/OPEN-QUESTIONS.md fråga 5.
#
# Frivilliga. Utan dem erbjuds bara "betala på plats" i menyn — ingen död knapp,
# och utvecklingsmiljön kräver inget konto hos en leverantör.
#
# Stripe finns i Kroatien och Sverige men INTE i Bosnien eller Serbien. Där
# krävs Monri (Payten/Asseco SEE), som läggs på samma gränssnitt när avtalet
# finns — adaptern saknas medvetet tills dess.
#
# Webhooken tar emot på /api/payments/webhook/stripe. Lokalt:
#   stripe listen --forward-to localhost:3000/api/payments/webhook/stripe
# Connect-händelser måste ingå (--forward-connect-to för direct charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Notiser ─────────────────────────────────────────────────────────────────
# Frivilliga. Utan RESEND_API_KEY skickas ingen e-post — brevet skrivs i loggen
# i stället, så att utvecklingsmiljön inte kräver ett konto hos en leverantör.
# En order faller aldrig för att en notis inte kunde skickas.
RESEND_API_KEY=
# Måste ligga på en domän som är verifierad hos leverantören.
NOTIFY_FROM=Burp <notiser@burp.se>
# Burps egen adress. Dit går ansökningar från /anslut.
BURP_OPS_EMAIL=

# ── Burps avgift ────────────────────────────────────────────────────────────
# Standardavgift i baspunkter (340 = 3,40 %). Kan överstyras per restaurang
# via restaurants.fee_override_bps. Se docs/OPEN-QUESTIONS.md fråga 1.
BURP_DEFAULT_FEE_BPS=340
